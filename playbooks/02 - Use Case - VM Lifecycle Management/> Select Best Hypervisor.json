        {
            "@type": "WorkflowStep",
            "name": "Select Hypervisor",
            "description": null,
            "arguments": {
                "hypervisor": "{%- set _hypervisors=[\"KVM\", \"Proxmox\"]-%}\n{# Not enough resources on KVM #}\n{%- if vars.kvm_free_disk_mb < vars.vm_teplate_disk_size_mb or vars.kvm_free_mem_mb < vars.vm_teplate_mem_size_mb -%}\n{%- set _hypervisors = _hypervisors | reject('equalto', 'KVM') | list -%}\n{%- endif -%}\n\n{# Not enough resources on Proxmox too #}\n{%- if vars.proxmo_free_disk_mb < vars.vm_teplate_disk_size_mb or vars.proxmo_free_mem_mb < vars.vm_teplate_mem_size_mb -%}\n{%- set _hypervisors = _hypervisors | reject('equalto', 'Proxmox') | list -%}\n{%- endif -%}\n{%- if _hypervisors|length == 1 -%}\n{{_hypervisors[0]}}\n{%- elif _hypervisors|length == 2 -%}\n{# weights: RAM 75%, Disk 25% #}\n{%- set max_mem  = [vars.kvm_free_mem_mb, vars.proxmo_free_mem_mb]|max -%}\n{%- set max_disk = [vars.kvm_free_disk_mb, vars.proxmo_free_disk_mb]|max -%}\n{%- set kvm_score = 0.75 * (vars.kvm_free_mem_mb \/ (max_mem if max_mem > 0 else 1)) + 0.25 * (vars.kvm_free_disk_mb \/ (max_disk if max_disk > 0 else 1)) -%}\n{%- set px_score  = 0.75 * (vars.proxmo_free_mem_mb  \/ (max_mem if max_mem > 0 else 1)) + 0.25 * (vars.proxmo_free_disk_mb  \/ (max_disk if max_disk > 0 else 1)) -%}\n{{ 'KVM' if kvm_score >= px_score else 'Proxmox' }}\n{%- endif -%}"
            },
            "status": null,
