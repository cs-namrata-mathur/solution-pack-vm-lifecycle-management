        {
            "@type": "WorkflowStep",
            "name": "Configuration",
            "description": "Reads VM Instance sizing. disk_gb defaults to 10 for CT rootfs. VM resize uses diskGB on the record only when it differs from proxmox_default_disk_gb (10).",
            "arguments": {
                "bridge": "br0",
                "ci_user": "root",
                "gateway": "10.255.255.1",
                "vm_name": "{{vars.input.records[0].name}}",
                "vm_type": "{{vars.input.records[0].vMType.itemValue}}",
                "cpu_cores": "1",
                "memory_mb": "512",
                "json_to_html": "#!\/usr\/bin\/env python3\n\"\"\"Convert nested JSON into a colorful HTML table.\n\nUsage:\n    python json_to_colorful_table.py\n\nThe script renders nested dicts\/lists recursively, so complex JSON objects are\nshown as nested HTML tables with a colorful theme.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport html\nfrom typing import Any\n\n\n# --- Color configuration --------------------------------------------------\n# Edit these defaults to change the generated HTML theme.\nCARD_BG = \"#ffffff\"\nBORDER_COLOR = \"#d7e0ea\"\nHEADER_GRADIENT = \"linear-gradient(135deg, #2563eb, #7c3aed)\"\nKEY_COLOR = \"#0f766e\"\nSTRING_COLOR = \"#3a2c9f\"\nNUMBER_COLOR = \"#0369a1\"\nBOOLEAN_COLOR = \"#be123c\"\nNULL_COLOR = \"#6b7280\"\nROW_COLORS = {\n    \"row-a\": \"#eaf2ff\",\n    \"row-b\": \"#edf9f0\",\n    \"row-c\": \"#f4efff\",\n    \"row-d\": \"#bccbcb\",\n}\n\n\n# --- Static data ----------------------------------------------------------\n# Replace this object with your own nested JSON-like structure.\nSTATIC_JSON_DATA: dict[str, Any] = {\n    \"name\": \"example-vm\",\n    \"status\": \"running\",\n    \"resources\": {\n        \"cpu\": 4,\n        \"memory_mb\": 8192,\n        \"disk_gb\": 80,\n    },\n    \"network\": {\n        \"interfaces\": [\n            {\"name\": \"eth0\", \"ip\": \"10.0.0.10\/24\", \"gateway\": \"10.0.0.1\"},\n            {\"name\": \"eth1\", \"ip\": \"192.168.1.10\/24\", \"gateway\": \"192.168.1.1\"},\n        ],\n        \"dns\": [\"1.1.1.1\", \"8.8.8.8\"],\n    },\n    \"tags\": [\"prod\", \"web\", \"linux\"],\n    \"metadata\": None,\n}\n\n\ndef render_scalar(value: Any) -> str:\n    if value is None:\n        return f'<span style=\"color:{NULL_COLOR};font-style:italic;\">null<\/span>'\n    if isinstance(value, bool):\n        return f'<span style=\"color:{BOOLEAN_COLOR};\">{str(value).lower()}<\/span>'\n    if isinstance(value, (int, float)):\n        return f'<span style=\"color:{NUMBER_COLOR};\">{html.escape(str(value))}<\/span>'\n    return f'<span style=\"color:{STRING_COLOR};\">{html.escape(str(value))}<\/span>'\n\n\ndef table_style() -> str:\n    return (\n        \"width:100%;\"\n        \"border-collapse:separate;\"\n        \"border-spacing:0;\"\n        f\"background:{CARD_BG};\"\n        f\"border:1px solid {BORDER_COLOR};\"\n        \"border-radius:16px;\"\n        \"overflow:hidden;\"\n        \"box-shadow:0 12px 30px rgba(15, 23, 42, 0.08);\"\n    )\n\n\ndef th_style() -> str:\n    return (\n        \"text-align:left;\"\n        \"padding:12px 14px;\"\n        \"color:#ffffff;\"\n        f\"background:{HEADER_GRADIENT};\"\n        \"font-size:13px;\"\n        \"text-transform:uppercase;\"\n        \"letter-spacing:0.08em;\"\n    )\n\n\ndef td_style(row_class: str) -> str:\n    return (\n        \"padding:12px 14px;\"\n        f\"border-top:1px solid {BORDER_COLOR};\"\n        \"vertical-align:top;\"\n        \"word-break:break-word;\"\n        f\"background:{ROW_COLORS[row_class]};\"\n    )\n\n\ndef key_style() -> str:\n    return f\"color:{KEY_COLOR};font-weight:700;\"\n\n\ndef nested_table_style() -> str:\n    return \"margin-top:8px;width:100%;border-collapse:separate;border-spacing:0;\"\n\n\ndef render_value(value: Any, depth: int = 0) -> str:\n    if isinstance(value, dict):\n        return render_object(value, depth + 1)\n    if isinstance(value, list):\n        if not value:\n            return f'<span style=\"color:{NULL_COLOR};font-style:italic;\">[]<\/span>'\n        if all(not isinstance(item, (dict, list)) for item in value):\n            items = \", \".join(render_scalar(item) for item in value)\n            return f\"<div>{items}<\/div>\"\n        rows = []\n        for index, item in enumerate(value):\n            row_class = row_class_for_depth(depth)\n            rows.append(\n                \"<tr><td style=\\\"{td_style}\\\"><span style=\\\"{key_style}\\\">[{index}]<\/span><\/td><td style=\\\"{td_style}\\\">{content}<\/td><\/tr>\".format(\n                    td_style=td_style(row_class),\n                    key_style=key_style(),\n                    index=index,\n                    content=render_value(item, depth + 1),\n                )\n            )\n        return (\n            f'<table style=\"{nested_table_style()}\">'\n            f\"<tbody>{''.join(rows)}<\/tbody><\/table>\"\n        )\n    return render_scalar(value)\n\n\ndef row_class_for_depth(depth: int) -> str:\n    classes = [\"row-a\", \"row-b\", \"row-c\", \"row-d\"]\n    return classes[depth % len(classes)]\n\n\ndef render_object(obj: dict[str, Any], depth: int = 0) -> str:\n    rows: list[str] = []\n    for key, value in obj.items():\n        row_class = row_class_for_depth(depth)\n        rows.append(\n        \"<tr><td style=\\\"{td_style}\\\"><span style=\\\"{key_style}\\\">{key}<\/span><\/td><td style=\\\"{td_style}\\\">{value}<\/td><\/tr>\".format(\n          td_style=td_style(row_class),\n          key_style=key_style(),\n                key=html.escape(str(key)),\n                value=render_value(value, depth + 1),\n            )\n        )\n    return (\n        f'<table style=\"{nested_table_style()}\">'\n        f\"<tbody>{''.join(rows)}<\/tbody><\/table>\"\n    )\n\n\ndef build_html(data: Any, title: str = \"JSON to HTML Table\") -> str:\n    body = render_value(data)\n    return f\"\"\"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" \/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" \/>\n  <title>{html.escape(title)}<\/title>\n<\/head>\n<body style=\"margin:0;padding:24px;font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\">\n  <div style=\"max-width:1200px;margin:0 auto;\">\n    <h1 style=\"margin:0 0 12px;font-size:28px;letter-spacing:-0.02em;\">{html.escape(title)}<\/h1>\n                <p style=\"margin:0 0 20px;\">Nested JSON rendered as a recursive HTML table.<\/p>\n    {body}\n  <\/div>\n<\/body>\n<\/html>\n\"\"\"\n\n\ndef main() -> int:\n    html_output = build_html(STATIC_JSON_DATA, title=\"JSON to HTML Table\")\n    print(html_output)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())",
                "root_password": "{% set specials = '-_@#~' %}\n{%- set chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789' + specials -%}\n{%- set ns = namespace(parts=[specials | random]) -%}\n{%- for _ in range(9) -%}\n  {% set ns.parts = ns.parts + [chars | random] %}\n{%- endfor -%}\n{{ ns.parts | shuffle | join('') }}",
                "vm_ip_address": "{{vars.input.records[0].networkInterfaces.iPAddress}}",
